# Maintainer: Fl1pMoniz <fl1pmoniz@users.noreply.github.com>
pkgname=rofi-universal
pkgver=0.3.1
pkgrel=1
pkgdesc="Unified search mode for Rofi inspired by KRunner and Spotlight"
arch=('x86_64' 'aarch64')
url="https://github.com/Fl1pMoniz/rofi-universal"
license=('MIT')
depends=('rofi' 'glib2' 'bash')
makedepends=('meson' 'ninja' 'gcc' 'pkgconf' 'cairo')
optdepends=(
  'qalculate: calculations, units and currency'
  'fd: asynchronous file search'
  'cliphist: clipboard history'
  'wl-clipboard: Wayland clipboard support'
  'xclip: X11 clipboard support'
  'jq: Chromium bookmark parsing'
  'sqlite: Firefox and Zen bookmark parsing'
  'curl: inline weather'
  'wget: inline weather fallback'
)
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('dcaf6c03adb65add82437f2a33848f638be1e52260f38e65e82ba7adae710f6e')

build() {
  cd "$pkgname-$pkgver"
  meson setup build --prefix=/usr --buildtype=release -Dwerror=true
  meson compile -C build
}

check() {
  cd "$pkgname-$pkgver"
  meson test -C build --print-errorlogs
}

package() {
  cd "$pkgname-$pkgver"
  meson install -C build --destdir "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
